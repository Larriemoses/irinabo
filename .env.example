# Public application URL used for passenger QR/share links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase public client configuration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase key. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Twilio WhatsApp Sandbox / messaging configuration.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
TWILIO_WHATSAPP_SANDBOX_CODE=

# Product AI provider. If unset, IrinAbo uses the deterministic fallback.
AI_API_KEY=
AI_TEXT_MODEL=openai/gpt-4o-mini

# Authenticated internal escalation endpoint.
INTERNAL_CRON_SECRET=

# Optional local bootstrap password used by scripts/bootstrap-demo-staff.mjs.
DEMO_STAFF_PASSWORD=
